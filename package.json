{
  "name": "vue-globe",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Interactive WebGL globe for Vue 3: countries, markers, animated arcs and choropleth regions.",
  "license": "MIT",
  "author": {
    "name": "Gabriel Carlos Ferreira",
    "email": "gabriel.developed@gmail.com",
    "url": "https://gbrldev.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-globe.js"
    },
    "./style.css": "./dist/vue-globe.css"
  },
  "main": "./dist/vue-globe.js",
  "module": "./dist/vue-globe.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbrlstr/vue-globe.git"
  },
  "homepage": "https://github.com/gbrlstr/vue-globe#readme",
  "bugs": {
    "url": "https://github.com/gbrlstr/vue-globe/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "globe",
    "globe.gl",
    "webgl",
    "threejs",
    "three",
    "3d",
    "map",
    "countries",
    "choropleth",
    "arcs",
    "markers",
    "visualization",
    "earth"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "examples": "npm run build && npx --yes serve .",
    "prepublishOnly": "npm run build",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "three": "^0.184.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "three": "^0.184.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
